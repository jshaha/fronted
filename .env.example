# Claude: live calls the API; replay uses fixtures/replays (default, offline)
CLAUDE_MODE=replay
# Required only for CLAUDE_MODE=live and npm run record
ANTHROPIC_API_KEY=
# Model overrides (default claude-sonnet-5-5 for every site)
CLAUDE_MODEL_EXTRACTOR=claude-sonnet-5-5
CLAUDE_MODEL_RECEIPT=claude-sonnet-5-5
CLAUDE_MODEL_ADVISOR=claude-sonnet-5-5
CLAUDE_MODEL_PLANNER=claude-sonnet-5-5
# Opt in to server-side refusal fallbacks in live mode (beta)
CLAUDE_REFUSAL_FALLBACK=0
# Artificial latency added to replayed calls so the trace reads naturally
REPLAY_LATENCY_MS=450

# Portal worker: simulated (default) fills an in-app copy of the portal form, no browser;
# headed opens a visible Chromium window; headless runs Chromium without a window
PORTAL_RUNNER=simulated
# Where the worker files expense reports (must match PORTAL_ALLOWED_ORIGINS)
PORTAL_URL=http://localhost:3000/mock-portal
PORTAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Slow down each browser step (ms) so humans can follow along
PORTAL_STEP_DELAY_MS=350

# Card issuer: mock (local) or ramp (Ramp Developer API; sandbox unless RAMP_ENV=production)
ISSUER=mock
# Ramp app: Company → Developer → Create New App, Client Credentials grant, scopes
# limits:write cards:read_vault cards:read funds:write funds:read users:read
RAMP_ENV=sandbox
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Optional: the Ramp user who holds issued cards (default: first business user)
RAMP_CARDHOLDER_USER_ID=
CARD_BUFFER_PCT=20
RECEIPT_TOLERANCE_CENTS=50

# SQLite database file
DB_PATH=data/fronted.sqlite
